{
  "request": {
    "method": "PUT",
    "path": "/v1/config/hosts/target",
    "body": {
      "max_heavy": "0"
    },
    "headers": {
      "Idempotency-Key": "host-config-max-heavy-invalid",
      "Content-Type": "application/json"
    }
  },
  "response": {
